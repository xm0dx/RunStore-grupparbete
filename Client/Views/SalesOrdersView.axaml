<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Client.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1024" d:DesignHeight="768"
             x:Class="Client.Views.SalesOrdersView"
             x:DataType="vm:SalesOrdersViewModel">

  <Design.DataContext>
    <vm:SalesOrdersViewModel></vm:SalesOrdersViewModel>
  </Design.DataContext>

  <StackPanel>
    <TextBlock Classes="pageTitle" Text="Våra beställningar"/>

    <Border BorderBrush="White" BorderThickness="0 0 0 1" Padding="0 50 0 5">
      <!-- Rubriker -->
      <Grid ColumnDefinitions="200,200,*,75,75">
        <Label Grid.Column="0" Content="Ordernr" />
        <Label Grid.Column="1" Content="Orderdatum" />
        <Label Grid.Column="2" Content="KundId" HorizontalAlignment="Right" />
        <Label Grid.Column="3" HorizontalAlignment="Center" />
        <Label Grid.Column="4" HorizontalAlignment="Center" />
      </Grid>
    </Border>
    <ScrollViewer Height="400">
      <ItemsControl ItemsSource="{Binding SalesOrders}" Margin="0 10 0 0">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Grid ColumnDefinitions="200,200,*,75,75">
              <Label Grid.Column="0" Content="{Binding OrderNumber}" />
              <Label Grid.Column="1" Content="{Binding OrderDate}" />
              <Label Grid.Column="2" Content="{Binding CustomerId}" HorizontalAlignment="Right"/>
              <Button Grid.Column="3" Classes="icon-edit" Command="{Binding $parent[UserControl].DataContext.EditCommand}" CommandParameter="{Binding Id}" HorizontalAlignment="Center" />
              <Button Grid.Column="4" Classes="icon-delete" HorizontalAlignment="Center" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <Popup IsOpen="{Binding ShowDialog}" Placement="Center">
      <Border Padding="30" Background="{DynamicResource WarningPopUpGradient}" BorderBrush="White" BorderThickness="2" CornerRadius="30">
        <StackPanel Spacing="20">
          <StackPanel Spacing="20">
            <TextBlock Padding="20" Text="Är du säker på att du vill ta bort beställningen?" Foreground="White" FontSize="30" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="20">
            <Button Classes="warning" Command="{Binding ConfirmCommand}">Ja</Button>
            <Button Classes="warning" Command="{Binding CancelCommand}">Nej</Button>
          </StackPanel>
        </StackPanel>
      </Border>
    </Popup>

  </StackPanel>
</UserControl>
